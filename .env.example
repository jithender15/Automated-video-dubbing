# Whisper Model: tiny, base, small, medium, large
WHISPER_MODEL=base

# Speech Synthesis Voice (Microsoft Edge TTS)
# Common voices: en-US-AriaNeural (female), en-US-GuyNeural (male), en-GB-SoniaNeural (UK female)
TTS_VOICE=en-US-AriaNeural

# Translation Backend: google (default), marian, mock
TRANSLATION_BACKEND=google

# Directories
DOWNLOAD_DIR=downloads
TEMP_DIR=temp
OUTPUT_DIR=outputs
LOG_DIR=logs

# FFmpeg binary path override (optional if ffmpeg is in PATH)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
